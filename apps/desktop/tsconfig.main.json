{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 主进程与 preload 编译为 CommonJS：sandbox 模式下的 preload 只能是 CJS
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": "src/main"
  },
  "include": ["src/main"],
  "exclude": ["src/main/**/*.test.ts"]
}
